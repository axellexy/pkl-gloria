{
  "version": 2,
  "builds": [
    { "src": "api/index.go", "use": "@vercel/go" },
    { "src": "jurnal-frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.go" },
    { "src": "/", "dest": "/jurnal-frontend/index.html" },
    { "src": "/(.*)", "dest": "/jurnal-frontend/$1" }
  ]
}
