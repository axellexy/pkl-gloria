{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "jurnal-backend/api/index.go", "use": "@vercel/go" },
    { "src": "jurnal-frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { 
      "src": "/index.html", 
      "status": 301, 
      "headers": { "Location": "/" } 
    },
    { 
      "src": "/api/(.*)", 
      "dest": "jurnal-backend/api/index.go" 
    },
    { 
      "src": "/", 
      "dest": "jurnal-frontend/index.html" 
    },
    { 
      "src": "/(.*)", 
      "dest": "jurnal-frontend/$1" 
    }
  ]
}